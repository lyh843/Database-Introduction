<mxfile host="app.diagrams.net">
  <diagram name="EER Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 实体：驾驶员 -->
        <mxCell id="driver" value="驾驶员\n身份证号\n姓名\n地址\n电话" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- 子类：小车司机 -->
        <mxCell id="car_driver" value="小车司机\n驾龄" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="350" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- 子类：卡车司机 -->
        <mxCell id="truck_driver" value="卡车司机\n所属单位" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="350" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- ISA 关系 -->
        <mxCell id="isa" value="ISA" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="320" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- 实体：车辆 -->
        <mxCell id="vehicle" value="车辆\n车辆号码\n名称\n型号" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- 实体：驾驶证 -->
        <mxCell id="license" value="驾驶证\n驾驶证号\n发证单位" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- 联系：驾驶 -->
        <mxCell id="drive_rel" value="驾驶\n(M:N)" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="220" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- 联系：拥有 -->
        <mxCell id="own_rel" value="拥有\n(1:N)" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="220" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- 连线 -->
        <mxCell id="e1" style="endArrow=none;" edge="1" parent="1" source="driver" target="drive_rel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="endArrow=none;" edge="1" parent="1" source="vehicle" target="drive_rel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="endArrow=none;" edge="1" parent="1" source="driver" target="own_rel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="endArrow=none;" edge="1" parent="1" source="license" target="own_rel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ISA 连线 -->
        <mxCell id="e5" style="endArrow=none;" edge="1" parent="1" source="car_driver" target="isa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" style="endArrow=none;" edge="1" parent="1" source="truck_driver" target="isa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" style="endArrow=none;" edge="1" parent="1" source="isa" target="driver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>